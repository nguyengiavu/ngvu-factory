{
  "description": "ngvu guards. onFailure block: a guard that cannot run (no Git Bash, no working python) blocks the call instead of letting it through.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/hooks/ngvu_guardrails.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
